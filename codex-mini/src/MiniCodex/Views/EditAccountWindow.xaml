<Window x:Class="MiniCodex.Views.EditAccountWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit account" Width="600" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}">
    <StackPanel Margin="24">
        <TextBlock Text="Edit account" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,20" />
        <TextBlock Text="Display name" Margin="0,0,0,6" /><TextBox x:Name="AccountName" Margin="0,0,0,16" />
        <TextBlock Text="Codex home" Margin="0,0,0,6" />
        <DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="Browse" Margin="8,0,0,0" /><TextBox x:Name="Home" /></DockPanel>
        <TextBlock Text="Changing the home uses that folder's saved login and sessions. This resets the profile's local project/chat references, saved drafts, and queued messages. The old home and its history stay on disk." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="19" Margin="0,12,0,0" />
        <TextBlock x:Name="Error" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" /><Button Content="Save" Click="Save" IsDefault="True" Style="{StaticResource AccentButton}" /></StackPanel>
    </StackPanel>
</Window>
