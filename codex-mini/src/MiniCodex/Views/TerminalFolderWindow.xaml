<Window x:Class="MiniCodex.Views.TerminalFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open terminal · Mini Codex" Width="640" Height="450" MinWidth="500" MinHeight="320"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Open terminal" FontSize="21" FontWeight="SemiBold" />
            <TextBlock x:Name="ProjectName" TextTrimming="CharacterEllipsis" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
            <TextBlock Text="Choose a project folder for the terminal." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" />
        </StackPanel>
        <ListBox x:Name="Folders" Grid.Row="1" AutomationProperties.Name="Terminal working folder">
            <ListBox.ItemTemplate><DataTemplate>
                <StackPanel Margin="2,5" ToolTip="{Binding Path}">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Availability}" FontSize="10" Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="Error" Grid.Row="2" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Open terminal" Click="Accept" IsDefault="True" Style="{StaticResource AccentButton}" />
        </StackPanel>
    </Grid>
</Window>
