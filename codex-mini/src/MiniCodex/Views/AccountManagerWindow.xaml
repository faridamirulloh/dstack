<Window x:Class="MiniCodex.Views.AccountManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account overview · Mini Codex" Width="820" Height="640" MinWidth="680" MinHeight="460"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Account overview" FontSize="24" FontWeight="Medium" />
            <TextBlock Text="Usage, reset times, credits, and task status across your accounts. Closed accounts show their last reported usage." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <WrapPanel Margin="0,14,0,0">
                <Button Content="Refresh accounts" Click="RefreshAccounts" IsEnabled="{Binding CanRefreshAccounts}" Margin="0,0,8,0" />
                <Button Content="Connect Codex home…" Click="ConnectCodexHome" Margin="0,0,8,0" />
                <Button Content="+ Add account" Click="AddAccount" Style="{StaticResource AccentButton}" />
            </WrapPanel>
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" AutomationProperties.Name="Account profiles">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,9" ToolTip="{Binding Details}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="45" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Width="33" Height="33" Background="#323844" CornerRadius="6" HorizontalAlignment="Left"><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="11" /></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="Medium" /><TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /></StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,9,0,0">
                        <Border Background="{StaticResource SidebarBrush}" CornerRadius="5" Padding="10,8" ToolTip="{Binding UsageDetails}">
                            <StackPanel>
                                <WrapPanel>
                                    <TextBlock Text="{Binding Usage}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasResetCount, Converter={StaticResource BoolVisibility}}">
                                        <TextBlock Text="|" Foreground="{StaticResource FaintBrush}" Margin="5,0,2,0" VerticalAlignment="Center" />
                                        <Button Content="{Binding ResetLabel}" Click="OpenUsageResets" Style="{StaticResource ResetUsageButton}" />
                                    </StackPanel>
                                </WrapPanel>
                                <TextBlock Text="{Binding Credits}" FontSize="12" Margin="0,4,0,0" />
                                <DockPanel Margin="0,5,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Connection}" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Tasks}" FontSize="11" Foreground="{StaticResource GoodBrush}" /></DockPanel>
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{Binding AuthLabel}" Click="Authenticate" IsEnabled="{Binding CanAuthenticate}" Margin="0,0,8,0" MinWidth="90" />
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,8,0" IsEnabled="{Binding CanOpen}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Click="OpenAccountOptions" Style="{StaticResource QuietButton}" Width="26" Padding="0" ToolTip="Choose how to open this account" AutomationProperties.Name="Account opening options">
                                        <Path Data="M 1,1 L 5,5 L 9,1" Width="9" Height="5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Open side by side" Click="OpenAccountSideBySide" />
                                                <MenuItem Header="Open in new window" Click="OpenAccountWindow" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Border DockPanel.Dock="Right" Width="1" Background="{StaticResource LineBrush}" Margin="0,5" />
                                    <Button Content="{Binding ActionLabel}" Click="OpenAccount" Style="{StaticResource QuietButton}" MinWidth="105" />
                                </DockPanel>
                            </Border>
                            <Button Content="Edit" Click="EditAccount" IsEnabled="{Binding CanOpen}" Margin="0,0,8,0" />
                            <Button Content="Remove account" Click="RemoveAccount" IsEnabled="{Binding CanRemove}" />
                        </WrapPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
            <TextBlock Text="Remove account keeps its Codex home, saved login, and session history. Refresh accounts checks for changes made in Desktop or CLI. Closing this manager leaves account windows open." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
