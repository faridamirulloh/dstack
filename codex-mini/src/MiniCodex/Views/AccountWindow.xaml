<Window x:Class="MiniCodex.Views.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Codex" Width="1080" Height="810" MinWidth="820" MinHeight="640"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="AccountPaneDivider" TargetType="GridSplitter">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" />
                            <Canvas Height="0" VerticalAlignment="Center">
                                <Border x:Name="DividerActions" Canvas.Left="-17.5" Canvas.Top="-36" Width="40" Height="72"
                                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="4" Visibility="Collapsed">
                                    <StackPanel VerticalAlignment="Center">
                                        <Button Click="SwapPanes" Tag="{TemplateBinding Tag}" Style="{StaticResource QuietButton}"
                                                Width="28" Height="28" MinHeight="28" Padding="5" Margin="0,0,0,4" Cursor="Arrow"
                                                ToolTip="Swap account panes" AutomationProperties.Name="Swap account panes">
                                            <Path Data="M 3,5 H 17 M 13,1 L 17,5 L 13,9 M 17,15 H 3 M 7,11 L 3,15 L 7,19"
                                                  Width="16" Height="18" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Button>
                                        <Button Click="RecenterDivider" Tag="{TemplateBinding Tag}" Style="{StaticResource QuietButton}"
                                                Width="28" Height="28" MinHeight="28" Padding="5" Cursor="Arrow"
                                                ToolTip="Re-center divider" AutomationProperties.Name="Re-center divider">
                                            <Path Data="M 2,3 H 18 V 17 H 2 Z M 10,3 V 17"
                                                  Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DividerActions" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DividerActions" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer x:Name="PaneScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CanContentScroll="False">
        <Grid x:Name="PaneGrid" Width="{Binding ViewportWidth, ElementName=PaneScroller}" />
    </ScrollViewer>
</Window>
