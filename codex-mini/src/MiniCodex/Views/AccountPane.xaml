<UserControl x:Class="MiniCodex.Views.AccountPane"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MiniCodex.ViewModels"
        xmlns:views="clr-namespace:MiniCodex.Views"
        xmlns:presentation="clr-namespace:MiniCodex.Presentation"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}">
    <UserControl.Resources>
        <presentation:FindCardBrushConverter x:Key="FindCardBrush" />
        <Style x:Key="SessionSpinner" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Data" Value="M 7,1 A 6,6 0 1 1 1,7" />
            <Setter Property="Stroke" Value="#75CD91" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform"><Setter.Value><RotateTransform /></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions><BeginStoryboard x:Name="Spin"><Storyboard><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><StopStoryboard BeginStoryboardName="Spin" /></Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SpeedToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <Viewbox Width="14" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="Bolt" Data="M 10,1 L 2,11 L 8,11 L 6,21 L 16,8 L 10,8 Z" Fill="Transparent" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{StaticResource AccentInkBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Bolt" Property="Fill" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="QuoteCard">
            <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2,0,0,0" CornerRadius="3" Padding="9,6" Margin="0,0,0,6" ToolTipService.ShowDuration="60000">
                <Border.ToolTip><ScrollViewer MaxWidth="540" MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{Binding Quote}" TextWrapping="Wrap" /></ScrollViewer></Border.ToolTip>
                <StackPanel><TextBlock Text="Quoted from Codex" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,3" /><TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{StaticResource MutedBrush}" /></StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SentAnnotationCard">
            <Border Tag="FindAnnotation" Background="{StaticResource SidebarBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,9">
                <Border.BorderBrush><MultiBinding Converter="{StaticResource FindCardBrush}"><Binding /><Binding Path="DataContext.FindQuery" RelativeSource="{RelativeSource AncestorType=views:AccountPane}" /></MultiBinding></Border.BorderBrush>
                <StackPanel>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource QuoteCard}" />
                    <presentation:MarkdownMessageView Text="{Binding Comment}" FindText="{Binding DataContext.FindQuery, RelativeSource={RelativeSource AncestorType=views:AccountPane}}" Role="You" Visibility="{Binding HasComment, Converter={StaticResource BoolVisibility}}" Mentions="{Binding DataContext.MentionEntries, RelativeSource={RelativeSource AncestorType=views:AccountPane}}" BaseDirectory="{Binding DataContext.PrimaryFolder, RelativeSource={RelativeSource AncestorType=views:AccountPane}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="QuestionCard">
            <Border Tag="FindQuestion" Background="{StaticResource PanelBrush}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,9">
                <Border.BorderBrush><MultiBinding Converter="{StaticResource FindCardBrush}"><Binding /><Binding Path="DataContext.FindQuery" RelativeSource="{RelativeSource AncestorType=views:AccountPane}" /></MultiBinding></Border.BorderBrush>
                <StackPanel>
                    <TextBlock Text="{Binding Header}" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding Question}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,9" />
                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.Style><Style TargetType="ItemsControl"><Setter Property="IsEnabled" Value="{Binding DataContext.Runtime.Connected, RelativeSource={RelativeSource AncestorType=views:AccountPane}}" /><Style.Triggers><DataTrigger Binding="{Binding HasAnswer}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding DataContext.Message.CanAnswer, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <ToggleButton Style="{StaticResource QuestionChoiceButton}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="SelectQuestionOption" AutomationProperties.Name="{Binding Label}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="12" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Description}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </StackPanel>
                            </ToggleButton>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="IsEnabled" Value="{Binding DataContext.Runtime.Connected, RelativeSource={RelativeSource AncestorType=views:AccountPane}}" /><Style.Triggers><DataTrigger Binding="{Binding HasAnswer}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding DataContext.Message.CanAnswer, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="Your own answer" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                        <Border Style="{StaticResource ChatComposerSurface}" Padding="8">
                            <TextBox Text="{Binding CustomAnswer, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="CustomQuestionKeyDown" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="160" MaxLength="16000" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Padding="3" AutomationProperties.Name="Custom answer" ToolTip="Enter sends your answer. Shift+Enter adds a new line." />
                        </Border>
                        <Button Content="Send answer" Click="SendCustomQuestionAnswer" Style="{StaticResource AccentButton}" FontSize="11" HorizontalAlignment="Right" Margin="0,7,0,0" />
                    </StackPanel>
                    <Border Background="{StaticResource UserMessageBrush}" CornerRadius="5" Padding="11,9" Margin="0,7,0,0" Visibility="{Binding HasAnswer, Converter={StaticResource BoolVisibility}}">
                        <StackPanel><TextBlock Text="Your reply" Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,0,0,4" /><TextBlock Text="{Binding Answer}" TextWrapping="Wrap" /></StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AttachmentCard">
            <Button Initialized="InitializeAttachmentDrag" Click="OpenAttachment" Style="{StaticResource QuietButton}" Padding="7" Margin="0,0,6,6" HorizontalContentAlignment="Left" ToolTip="{Binding Path}">
                <StackPanel MaxWidth="190">
                    <Image Source="{Binding Thumbnail}" Height="90" MaxWidth="180" Stretch="Uniform" Margin="0,0,0,6" Visibility="{Binding IsImage, Converter={StaticResource BoolVisibility}}" ToolTip="Click to open. Drag to copy the original image file." />
                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{StaticResource FileLinkBrush}" />
                    <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource FaintBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="242" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="11,12,11,8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel x:Name="SplitActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Visibility="Collapsed">
                        <Button Content="↗" Click="DetachPane" Style="{StaticResource QuietButton}" Width="24" Padding="0" ToolTip="Move account to a new window" AutomationProperties.Name="Move account to a new window" />
                        <Button Content="×" Click="ClosePane" Style="{StaticResource QuietButton}" Width="24" Padding="0" ToolTip="Close account pane" AutomationProperties.Name="Close account pane" />
                    </StackPanel>
                    <Button Style="{StaticResource QuietButton}" Padding="7" HorizontalContentAlignment="Stretch" Click="OpenAccounts" ToolTip="Open account overview" AutomationProperties.Name="Open account manager">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /></Grid.ColumnDefinitions>
                            <Border Background="#323844" CornerRadius="6" Width="29" Height="29" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="11" /></Border>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding ProfileName}" FontWeight="Medium" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Runtime.Identity}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
                            <TextBlock Grid.Column="2" Text="⌄" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        </Grid>
                    </Button>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="4,8,0,4">
                    <WrapPanel>
                        <TextBlock Text="{Binding Runtime.Usage}" ToolTip="{Binding Runtime.UsageTooltip}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Runtime.HasResetCount, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="|" Foreground="{StaticResource FaintBrush}" FontSize="12" Margin="5,0,2,0" VerticalAlignment="Center" />
                            <Button Content="{Binding Runtime.ResetLabel}" Click="OpenUsageResets" Style="{StaticResource ResetUsageButton}" />
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding Runtime.Credits}" ToolTip="{Binding Runtime.UsageTooltip}" Foreground="{StaticResource FaintBrush}" FontSize="11" Margin="0,4,0,0" />
                    <WrapPanel x:Name="AuthPanel">
                        <WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding Runtime.SignedIn}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></WrapPanel.Style>
                        <Button Content="Sign in" Click="SignIn" FontSize="11" Padding="8,3" MinHeight="27" Margin="0,0,4,4" />
                        <Button Content="Device code" Click="DeviceSignIn" FontSize="11" Padding="8,3" MinHeight="27" Margin="0,0,0,4" ToolTip="Use this if browser callback sign-in cannot complete" />
                        <Button Content="Cancel sign-in" Click="CancelSignIn" FontSize="11" Padding="8,3" MinHeight="27" Visibility="{Binding Runtime.LoginPending, Converter={StaticResource BoolVisibility}}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Runtime.LoginHint}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource AccentBrush}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Runtime.LoginHint}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
                <DockPanel Grid.Row="2" Margin="7,0,0,4">
                    <Button x:Name="SearchButton" Content="⌕" DockPanel.Dock="Right" Width="27" MinHeight="26" Padding="0" Style="{StaticResource QuietButton}" Click="FocusSearch" ToolTip="Search chats" AutomationProperties.Name="Show chat search" />
                    <Button DockPanel.Dock="Right" Width="27" MinHeight="26" Padding="0" Style="{StaticResource QuietButton}" Click="MoreChats" IsEnabled="{Binding CanLoadMore}" ToolTip="Load more saved chats" AutomationProperties.Name="Load more chats">
                        <Path Data="M 2,2 L 12,2 M 2,5 L 12,5 M 7,8 L 7,14 M 4,11 L 7,14 L 10,11" Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Button>
                    <Button DockPanel.Dock="Right" Width="27" MinHeight="26" Padding="0" Style="{StaticResource QuietButton}" Click="RefreshChats" IsEnabled="{Binding CanRefreshSessions}" ToolTip="Refresh this account's sessions" AutomationProperties.Name="Refresh session list">
                        <Path Data="M 13,6 A 5.5,5.5 0 1 0 12.5,10 M 13,2 L 13,6 L 9,6" Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Button>
                    <Button Content="+" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Click="NewProject" ToolTip="New project" Width="30" Padding="0" MinHeight="26" />
                    <Button DockPanel.Dock="Right" Width="27" MinHeight="26" Padding="0" Click="UseLastActiveProjectOrder" ToolTip="Order projects by latest task start. Drag a project to use a custom order." AutomationProperties.Name="Order projects by latest task start">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButton}"><Style.Triggers><DataTrigger Binding="{Binding OrderProjectsByLastActive}" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Setter Property="Background" Value="{StaticResource AccentInkBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        <Path Data="M 3,16 L 7,20 L 11,16 M 7,4 V 20 M 11,4 H 21 M 11,8 H 18 M 11,12 H 15" Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Button>
                    <TextBlock Text="PROJECTS" FontSize="11" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBox x:Name="SearchBox" Grid.Row="3" Margin="3,0,3,8" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolVisibility}}" GotKeyboardFocus="SearchFocused" LostKeyboardFocus="SearchUnfocused" PreviewKeyDown="SearchKeyDown" Padding="7,5" FontSize="11" AutomationProperties.Name="Search chats" ToolTip="Search chat or project names" />
                <DockPanel Grid.Row="4">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding SessionListStatus}" ToolTip="{Binding SessionListDetails}" FontSize="10" Foreground="{StaticResource FaintBrush}" TextTrimming="CharacterEllipsis" Margin="7,0,4,6" />
                <TreeView ItemsSource="{Binding SessionProjects}" SelectedItemChanged="SessionTreeSelectionChanged" PreviewMouseLeftButtonDown="ExpandProjectHeader" PreviewMouseLeftButtonUp="ExpandProjectHeader" PreviewMouseRightButtonDown="OpenTreeOptions" AutomationProperties.Name="Projects and other chats for this account">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type vm:SessionTreeNode}" ItemsSource="{Binding Children}">
                            <Grid>
                            <Grid ToolTip="{Binding Tooltip}" Background="Transparent" AllowDrop="True" PreviewMouseLeftButtonDown="ProjectDragStart" PreviewMouseLeftButtonUp="ProjectDragEnd" PreviewMouseMove="ProjectDragMove" PreviewDragOver="ProjectDragOver" PreviewDrop="ProjectDrop" PreviewDragLeave="ProjectDragLeave">
                                <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsLoadMore}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Grid Height="{Binding ActualHeight, ElementName=SessionLabel}" VerticalAlignment="Center">
                                    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsDeleting}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsArchiving}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                                <TextBlock FontFamily="Segoe MDL2 Assets" VerticalAlignment="Top" Margin="0,2,0,0" FontSize="12">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="&#xE8B7;" /><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsSession}" Value="True"><Setter Property="Text" Value="&#xE8BD;" /><Setter Property="Foreground" Value="{StaticResource FaintBrush}" /></DataTrigger><DataTrigger Binding="{Binding HasDraft}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding HasUnreadCompletion}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsPaused}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsStopped}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsSection}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <Path Style="{StaticResource SessionSpinner}" Visibility="{Binding IsRunning, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0" ToolTip="Task running" AutomationProperties.Name="Task running" />
                                <Grid Width="14" Height="14" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0" Visibility="{Binding IsPaused, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding ActivityTooltip}" AutomationProperties.Name="{Binding Activity}">
                                    <Ellipse Stroke="{StaticResource PausedTaskBrush}" StrokeThickness="1.4" />
                                    <Path Data="M 5,4.5 L 5,9.5 M 9,4.5 L 9,9.5" Stroke="{StaticResource PausedTaskBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                                <Grid Width="14" Height="14" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0" Visibility="{Binding IsStopped, Converter={StaticResource BoolVisibility}}" ToolTip="{Binding ActivityTooltip}" AutomationProperties.Name="{Binding Activity}">
                                    <Ellipse Stroke="{StaticResource DangerBrush}" StrokeThickness="1.4" />
                                    <Rectangle Width="5" Height="5" Fill="{StaticResource DangerBrush}" />
                                </Grid>
                                <Grid Width="14" Height="14" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0" ToolTip="Task completed. Open chat to view." AutomationProperties.Name="Completed task, unread">
                                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSession}" Value="True" /><Condition Binding="{Binding HasUnreadCompletion}" Value="True" /><Condition Binding="{Binding IsRunning}" Value="False" /><Condition Binding="{Binding IsPaused}" Value="False" /><Condition Binding="{Binding IsStopped}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
                                    <Ellipse Stroke="{StaticResource GoodBrush}" StrokeThickness="1.4" />
                                    <Path Data="M 3.5,7 L 6,9.5 L 10.5,4.5" Stroke="{StaticResource GoodBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Grid>
                                <Canvas Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,2,0,0" ToolTip="Unsent draft" AutomationProperties.Name="Unsent draft">
                                    <Canvas.Style><Style TargetType="Canvas"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsSession}" Value="True" /><Condition Binding="{Binding HasDraft}" Value="True" /><Condition Binding="{Binding HasUnreadCompletion}" Value="False" /><Condition Binding="{Binding IsRunning}" Value="False" /><Condition Binding="{Binding IsPaused}" Value="False" /><Condition Binding="{Binding IsStopped}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Canvas.Style>
                                    <Path Data="M 1,1 L 13,1 L 13,10 L 6,10 L 3,13 L 3,10 L 1,10 Z" Stroke="{StaticResource FaintBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" />
                                    <Ellipse Canvas.Left="3.2" Canvas.Top="4.7" Width="1.6" Height="1.6" Fill="{StaticResource AccentBrush}" />
                                    <Ellipse Canvas.Left="6.2" Canvas.Top="4.7" Width="1.6" Height="1.6" Fill="{StaticResource AccentBrush}" />
                                    <Ellipse Canvas.Left="9.2" Canvas.Top="4.7" Width="1.6" Height="1.6" Fill="{StaticResource AccentBrush}" />
                                </Canvas>
                                </Grid>
                                <Path Style="{StaticResource SessionSpinner}" Stroke="{StaticResource DangerBrush}" Visibility="{Binding IsDeleting, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0" ToolTip="Deletion in progress…" AutomationProperties.Name="Deletion in progress" />
                                <Path Style="{StaticResource SessionSpinner}" Stroke="{StaticResource PausedTaskBrush}" Visibility="{Binding IsArchiving, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0" ToolTip="Archiving…" AutomationProperties.Name="Archiving" />
                                <StackPanel x:Name="SessionLabel" VerticalAlignment="Center">
                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Grid.Column" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding IsSection}" Value="True"><Setter Property="Grid.Column" Value="0" /><Setter Property="Grid.ColumnSpan" Value="2" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Normal" /><Style.Triggers><DataTrigger Binding="{Binding IsProject}" Value="True"><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger><DataTrigger Binding="{Binding IsSection}" Value="True"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{StaticResource FaintBrush}" /></DataTrigger><DataTrigger Binding="{Binding IsArchiving}" Value="True"><Setter Property="Foreground" Value="{StaticResource PausedTaskBrush}" /></DataTrigger><DataTrigger Binding="{Binding IsDeleting}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource BoolVisibility}}" Foreground="{StaticResource FaintBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Visibility="{Binding IsProject, Converter={StaticResource BoolVisibility}}">
                                <Button Content="+" Style="{StaticResource QuietButton}" Padding="0" Width="24" MinHeight="25" Click="ProjectNewChat" IsEnabled="{Binding CanCreateChat}" ToolTip="New chat in this project" AutomationProperties.Name="New chat in project" />
                                <Button Content="⋯" Style="{StaticResource QuietButton}" Padding="0" Width="24" MinHeight="25" VerticalAlignment="Top" Click="OpenProjectMenu" ToolTip="Project actions">
                                    <Button.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="PrepareProjectFolderMenu">
                                            <MenuItem Header="{Binding OpenLabel}" Click="OpenTreeProject" />
                                            <MenuItem Header="Open folder in Explorer" Tag="ProjectFolders" Click="OpenProjectFolder" />
                                            <MenuItem Header="Open terminal" Tag="ProjectTerminal" Click="OpenProjectTerminalFolder" />
                                            <MenuItem Header="New chat" Click="ProjectNewChat" IsEnabled="{Binding CanCreateChat}" />
                                            <MenuItem Header="Manage folders…" Click="ManageFolders" IsEnabled="{Binding CanManageProject}" />
                                            <MenuItem Header="{Binding ArchiveProjectLabel}" Click="ArchiveProject" IsEnabled="{Binding CanCreateChat}" ToolTip="{Binding ArchiveProjectTooltip}" />
                                            <MenuItem Header="Archive chats older than 30 days" Click="ArchiveOldProjectChats" IsEnabled="{Binding CanCreateChat}" ToolTip="Archive chats whose last activity was more than 30 days ago." />
                                            <MenuItem Header="Delete all archived chats…" Tag="DeleteArchived" Click="DeleteProjectArchivedChats" Foreground="{StaticResource DangerBrush}" IsEnabled="{Binding CanCreateChat}" Visibility="Collapsed" />
                                            <MenuItem Header="Delete project…" Click="DeleteProject" Foreground="{StaticResource DangerBrush}" Visibility="{Binding CanDeleteProject, Converter={StaticResource BoolVisibility}}" />
                                            <Separator /><MenuItem Header="New project…" Click="NewProject" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                </StackPanel>
