                                </Button>
                                <Button Click="OpenCapabilityExplorer" Style="{StaticResource QuietButton}" Width="28" MinHeight="25" Padding="0" IsEnabled="{Binding HasProject}" ToolTip="Plugins &amp; skills" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Plugins and skills">
                                    <Path Data="M 2,3 L 6,3 C 5,0 11,0 10,3 L 14,3 L 14,7 C 17,6 17,12 14,11 L 14,15 L 10,15 C 11,12 5,12 6,15 L 2,15 L 2,11 C 5,12 5,6 2,7 Z" Width="12" Height="12" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" />
                                </Button>
                            </WrapPanel>
                        </DockPanel>
                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <ItemsControl x:Name="DraftQuotes" ItemsSource="{Binding DraftAnnotations}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel><Button DockPanel.Dock="Right" Content="×" Click="RemoveAnnotation" Style="{StaticResource QuietButton}" MinHeight="24" Width="25" Padding="0" ToolTip="Remove annotation" /><ContentControl Content="{Binding}" ContentTemplate="{StaticResource QuoteCard}" /></DockPanel>
                                        <TextBlock Text="Your comment" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,5" />
                                        <TextBox x:Name="AnnotationComment" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="AnnotationCommentKeyDown" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" MaxHeight="120" MaxLength="8000" VerticalScrollBarVisibility="Auto" ToolTip="Enter confirms the comment. Shift+Enter adds a new line." AutomationProperties.Name="Comment on annotation" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding DraftAttachments}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><StackPanel><ContentControl Content="{Binding}" ContentTemplate="{StaticResource AttachmentCard}" /><Button Content="Remove" Click="RemoveAttachment" Style="{StaticResource QuietButton}" FontSize="10" MinHeight="22" Margin="0,0,6,6" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                        </ScrollViewer>
                        <presentation:MentionInput x:Name="Composer" Style="{StaticResource ChatComposerInput}" References="{Binding MentionEntries}" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="ComposerKeyDown" TextChanged="ComposerTextChanged" SelectionChanged="ComposerSelectionChanged" IsEnabled="{Binding CanCompose}" AutomationProperties.Name="Message draft" />
                        <Popup x:Name="MentionPopup" PlacementTarget="{Binding ElementName=Composer}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" Closed="MentionPopupClosed">
                            <Border presentation:AppZoom.Enabled="True" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="6" Width="{Binding ActualWidth, ElementName=Composer}" MaxWidth="620">
                                <StackPanel>
                                    <ListBox x:Name="MentionList" MaxHeight="260" PreviewMouseLeftButtonUp="MentionClicked" PreviewKeyDown="MentionKeyDown" AutomationProperties.Name="Mention suggestions">
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <StackPanel ToolTip="{Binding Tooltip}"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding KindLabel}" Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="12,0,0,0" /><TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" /></DockPanel><TextBlock Text="{Binding Detail}" Foreground="{StaticResource FaintBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /></StackPanel>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="MentionNotice" FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="7,6" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <DockPanel Margin="0,8,0,0">
                            <Border DockPanel.Dock="Right" Background="{StaticResource AccentBrush}" CornerRadius="5" Height="32" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Button Click="SendMessage" Style="{StaticResource AccentButton}" Background="Transparent" Width="34" Padding="0" IsEnabled="{Binding ReadyToSend}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding SendLabel}" AutomationProperties.HelpText="Enter activates this action. Shift+Enter adds a new line.">
                                        <Button.ToolTip><StackPanel>
                                            <TextBlock Text="{Binding SendLabel}" FontWeight="Medium" />
                                            <TextBlock Text="Enter to send or resume; Shift+Enter for a new line." />
                                            <TextBlock Text="While running, uses the selected Steer / Queue / Ask behavior." />
                                        </StackPanel></Button.ToolTip>
                                        <Path Width="13" Height="14" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                            <Path.Style><Style TargetType="Path">
                                                <Setter Property="Data" Value="M 7,13 L 7,1 M 2,6 L 7,1 L 12,6" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsResumeAction}" Value="True">
                                                    <Setter Property="Data" Value="M 3,1 L 13,7 L 3,13 Z" />
                                                    <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </DataTrigger></Style.Triggers>
                                            </Style></Path.Style>
                                        </Path>
                                    </Button>
                                    <Border Width="1" Margin="0,7" Background="{StaticResource AccentInkBrush}" Opacity="0.2" />
                                    <Button Click="OpenBusySendMenu" Style="{StaticResource AccentButton}" Background="Transparent" Width="24" Padding="0" ToolTip="{Binding BusySendMode, StringFormat='Send while running: {0}'}" AutomationProperties.Name="Send while running options">
                                        <Path Data="M 1,1 L 5,5 L 9,1" Width="9" Height="5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        <Button.ContextMenu><ContextMenu>
                                            <MenuItem Header="Steer" Tag="Steer" IsCheckable="True" Click="SelectBusySendMode" ToolTip="Add instructions to the current running task." />
                                            <MenuItem Header="Queue" Tag="Queue" IsCheckable="True" Click="SelectBusySendMode" ToolTip="Send after the running task completes successfully." />
                                            <MenuItem Header="Ask" Tag="Ask" IsCheckable="True" Click="SelectBusySendMode" ToolTip="Choose Steer or Queue each time you send during a task." />
                                        </ContextMenu></Button.ContextMenu>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Button DockPanel.Dock="Right" Click="StopTask" IsEnabled="{Binding CanStop}" Width="32" Height="32" VerticalAlignment="Center" Padding="0" Margin="0,0,5,0" ToolTip="Stop task" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Stop task">
                                <Path Data="M 1,1 L 11,1 L 11,11 L 1,11 Z" Width="10" Height="10" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="PredictButton" DockPanel.Dock="Right" Click="PredictNextMessage" Style="{StaticResource QuietButton}" Width="32" Padding="0" Margin="0,0,5,0" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Predict next messages using the selected model. Uses account usage. Open a chat with messages first." AutomationProperties.Name="Predict next message">
                                <Grid>
                                    <Path x:Name="PredictIcon" Data="M 7,1 L 8.6,5.4 L 13,7 L 8.6,8.6 L 7,13 L 5.4,8.6 L 1,7 L 5.4,5.4 Z M 13,0 L 13,4 M 11,2 L 15,2" Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <Path x:Name="PredictSpinner" Style="{StaticResource SessionSpinner}" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                            <WrapPanel>
                                <ComboBox Width="145" ItemsSource="{Binding Runtime.Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Name" ToolTip="{Binding SelectedModel.Name}" Margin="0,0,6,0" FontSize="11" IsEnabled="{Binding CanConfigure}" AutomationProperties.Name="Model" />
                                <ComboBox Width="91" ItemsSource="{Binding Efforts}" SelectedItem="{Binding Effort}" Margin="0,0,6,0" FontSize="11" IsEnabled="{Binding CanConfigure}" ToolTip="Reasoning preference for future Codex requests" AutomationProperties.Name="Reasoning effort" />
                                <ToggleButton Style="{StaticResource SpeedToggle}" IsChecked="{Binding FastMode, Mode=TwoWay}" ToolTip="{Binding SpeedTooltip}" AutomationProperties.Name="Fast mode" AutomationProperties.HelpText="{Binding SpeedTooltip}" Margin="0,0,6,0" IsEnabled="{Binding CanConfigure}" />
                                <ComboBox Width="120" ItemsSource="{Binding ApprovalModes}" SelectedItem="{Binding ApprovalMode}" FontSize="11" IsEnabled="{Binding CanConfigure}" ToolTip="Ask me prompts here. Auto approval uses Codex's reviewer and keeps the sandbox enabled." AutomationProperties.Name="Approval mode" />
                            </WrapPanel>
                        </DockPanel>
                        <Popup x:Name="PredictionPopup" PlacementTarget="{Binding ElementName=Composer}" Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None" Closed="PredictionPopupClosed">
                            <Border presentation:AppZoom.Enabled="True" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Width="{Binding ActualWidth, ElementName=Composer}" MinWidth="280" MaxWidth="560" Margin="0,0,0,6">
                                <StackPanel>
                                    <DockPanel Margin="2,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="×" Click="DismissPredictions" Style="{StaticResource QuietButton}" Width="24" MinHeight="24" Padding="0" ToolTip="Close predictions" AutomationProperties.Name="Close predictions" />
                                        <TextBlock Text="Suggested next messages" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock x:Name="PredictionStatus" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,0,2,6" />
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="PredictionItems" HorizontalContentAlignment="Stretch">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Button Click="UsePrediction" HorizontalContentAlignment="Stretch" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="10,8" Margin="0,3" ToolTip="Append to your draft" AutomationProperties.Name="{Binding}">
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" />
                                                </Button>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="Select to append to your draft. Uses account usage." FontSize="10" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="2,6,2,0" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border x:Name="ChatDropOverlay" Grid.RowSpan="3" Panel.ZIndex="10" Visibility="Collapsed" IsHitTestVisible="False" Background="#E617181B" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="8" Margin="10" Padding="20">
                <TextBlock x:Name="ChatDropHint" Text="Drop files or images to attach" FontSize="18" Foreground="{StaticResource AccentBrush}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="dstack codex" FontSize="11" Foreground="{StaticResource FaintBrush}" Margin="12,0,0,0" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding Runtime.Status}" FontSize="11" Margin="0,0,14,0"><TextBlock.ToolTip><StackPanel><TextBlock Text="Codex home" /><TextBlock Text="{Binding Runtime.HomePath}" /></StackPanel></TextBlock.ToolTip><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Runtime.Connected}" Value="False"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <TextBlock Text="{Binding SessionNotice}" FontSize="11" Foreground="{StaticResource WarningBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SessionNotice}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
