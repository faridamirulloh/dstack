<Window x:Class="MiniCodex.Views.ManageFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage folders · Mini Codex" Width="780" Height="620" MinWidth="600" MinHeight="520"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Manage folders" FontSize="22" FontWeight="Medium" />
            <TextBlock Text="Every chat in this project uses all attached folders." Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
            <TextBlock Text="Folder changes apply to the next task. Running tasks keep their current folders." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,20,0,16">
            <TextBlock Text="Project name" Margin="0,0,0,6" />
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Project name" />
        </StackPanel>
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Content="Remove selected" IsEnabled="{Binding CanRemove}" Click="RemoveFolder" ToolTip="Choose another primary folder before removing the current primary." Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="+ Add folders…" Click="AddFolders" HorizontalAlignment="Right" />
            <TextBlock Text="Project folders" FontWeight="Medium" VerticalAlignment="Center" />
        </DockPanel>
        <Border Grid.Row="3" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6">
            <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" Margin="5" AutomationProperties.Name="Project folders">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ToolTip="{Binding Path}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                <TextBlock Text="{Binding Path}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,4,12,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Availability}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <StackPanel Grid.Row="4" Margin="0,18,0,0">
            <TextBlock Text="Primary folder" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding Folders}" SelectedItem="{Binding PrimaryFolder}" DisplayMemberPath="Display" AutomationProperties.Name="Primary folder" />
            <TextBlock Text="Commands start here. Other project folders stay available to every chat." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
        <TextBlock Grid.Row="5" Text="{Binding Notice}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="85" Margin="0,0,8,0" />
            <Button Content="Save project" Click="Save" IsDefault="True" Style="{StaticResource AccentButton}" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
