<Window x:Class="MiniCodex.Views.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex approval" Width="650" Height="560" MinWidth="500" MinHeight="400"
        Style="{StaticResource {x:Type Window}}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16"><TextBlock x:Name="Heading" FontSize="21" FontWeight="Medium" /><TextBlock x:Name="Scope" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Fields">
                <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" MinHeight="90" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Decline" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="AllowSession" Content="Allow for chat" Click="AcceptSession" Margin="0,0,8,0" />
            <Button x:Name="AllowOnce" Content="Allow once" Click="Accept" Style="{StaticResource AccentButton}" />
        </StackPanel>
    </Grid>
</Window>
